{
  "document": "Claudia Z dictionary candidate rules",
  "status": "draft_for_review_not_auto_applied",
  "source_workspace": "Claudia Z Archive Raw History",
  "principles": [
    "Do not inflate categories.",
    "Actor is not category.",
    "Private/external money movement is not commercial_income.",
    "Safe/сейф is cash context, not a separate category or flow.",
    "Income is owner funding unless the description explicitly says commercial yacht revenue such as аренда, сдача яхты, чартер, booking, charter, or rental.",
    "Archive raw history trains dictionaries only; it does not create operational entries.",
    "Weak words and mixed rows stay in review."
    ,
    "Unsortable rows can map to other only with review, not as silently recognized expenses."
  ],
  "category_groups": {
    "money_balance": [
      "commercial_income",
      "non_commercial_income",
      "cash_topup_from_card"
    ],
    "crew": [
      "crew"
    ],
    "voyage_operations": [
      "fuel",
      "marina_ports",
      "berth"
    ],
    "maintenance": [
      "service_water",
      "tech_parts",
      "dry_dock",
      "tender"
    ],
    "household_guests": [
      "provisions",
      "guest_trip_support",
      "guest_cash_issued",
      "representation_expenses",
      "cleaning",
      "interior"
    ],
    "overhead": [
      "media_comms",
      "transport_expenses",
      "admin_legal",
      "current_boat_expenses"
    ],
    "review_and_accounting_blocks": [
      "other",
      "lower_accounting",
      "admin_debt"
    ]
  },
