  "semantic_markers_not_categories": [
    {
      "marker": "cash_location_safe",
      "patterns": [
        "сейф",
        "сеф",
        "из сейфа",
        "из сефа",
        "в сейф",
        "в сеф",
        "взял из сейфа",
        "забрал из сейфа",
        "получено из сейфа",
        "получил из сейфа",
        "принял из сейфа",
        "убрал в сейф",
        "положил в сейф",
        "принял сейфы"
      ],
      "rule": "Treat safe/сейф as cash source/location context. It is not a category, not commercial_income, and not a separate MVP flow."
    },
    {
      "marker": "owner_funding",
      "patterns": [
        "от Александра",
        "Александр",
        "александр",
        "от Саши",
        "Саша",
        "принял",
        "Наталия",
        "от Наталии",
        "Арик",
        "от Арика",
        "от Данила",
        "получил от Данилы",
        "из Германии",
        "из крипты",
        "через крипту",
        "Пришло из крипты",
        "usdt",
        "усдт",
        "приход из рф",
        "пополнение служебной карты",
        "пришли на банк ерсте",
        "Я внес свои"
      ],
      "rule": "Treat as owner/source funding income with source actor from description where possible. Do not map to commercial_income."
    },
    {
      "marker": "commercial_income_allowed",
      "patterns": [
        "аренда яхты",
        "ареда яхты",
        "яхта аренда",
        "сдача яхты",
        "чартер",
        "оплата чартера",
        "charter",
        "yacht rental",
        "yacht booking"
      ],
      "rule": "Only income rows with explicit yacht/charter commercial wording can map to commercial_income. Generic аренда авто/тендера is not enough."
    },
    {
      "marker": "money_movement",
      "patterns": [
        "остаток",
        "переход",
        "пополнение карты",
        "пополнение служебной карты",
        "вернул в кеш кассу",
        "остались на карте. сдал",
        "оплатил с карты для себя",
        "сдал",
        "снял кеш с карты",
        "кеш с карты"
      ],
      "rule": "Use as semantic-only money movement / private settlement context, not as expense category. Keep out of commercial_income unless commercial_income_allowed also matches."
    },
    {
      "marker": "debt_or_return",
      "patterns": [
        "долг",
        "мой долг",
        "возврат",
        "вернул",
        "кредит",
        "займ",
        "заем",
        "рассрочка",
        "под отчет",
        "подотчет"
      ],
      "rule": "Use as a separate lower accounting block / semantic marker; do not create an expense category from loan, debt, credit, return, or accountable wording alone."
    },
    {
      "marker": "admin_debt",
      "patterns": [
        "мой кредит",
        "моя часть кредита",
        "кредит себе",
        "последний кредит",
        "мой долг",
        "для себя",
        "себе",
        "домой",
        "с тему",
        "temu",
        "мото навигатор"
      ],
      "rule": "Use as administrator liability/reporting context, not as an operational expense category. Show it in a separate report block with returned/open amounts."
    },
    {
      "marker": "non_yacht_or_personal",
      "patterns": [
        "Порше",
        "porsche",
        "для РФ",
        "катер РФ",
        "аудио система для РФ",
        "музыка на катер РФ",
        "мото навигатор"
      ],
      "rule": "Use as semantic-only personal/non-yacht context. Do not train Claudia Z yacht operational categories from these rows."
    },
    {
      "marker": "actor_context",
      "patterns": [
        "Вова",
        "Володя",
        "Женя",
        "Евгения",
        "Наталья",
        "Александр",
        "Алексей",
        "Данил",
        "Гурко"
      ],
      "rule": "Actor/source names alone are context markers. Expense-side ЛВ/guest cash wording belongs to guest_cash_issued."
    }
  ],
